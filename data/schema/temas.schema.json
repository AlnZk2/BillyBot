{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Temas visuais do BillyBot",
  "type": "object",
  "required": ["padrao"],
  "properties": { "$schema": { "type": "string" } },
  "additionalProperties": {
    "type": "object",
    "required": ["cor"],
    "properties": {
      "cor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
      "icone": { "type": "string" },
      "nome": { "type": "string" }
    }
  }
}
